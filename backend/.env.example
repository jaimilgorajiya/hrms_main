# Server & Database Configuration
PORT=7000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ems
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ems

# Security & Client URL
JWT_SECRET=your_jwt_secret_key_here_change_it_in_production
CLIENT_URL=http://localhost:5173

# Master Admin
MASTER_ADMIN_EMAIL=jaimilgorajiya555@gmail.com
# MASTER_ADMIN_API_KEY=your_master_admin_api_key

# Uploads
UPLOAD_DIR=public/uploads

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Firebase Configuration (for mobile OTP login verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay (Optional - for payments)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
